{
  "name": "agent-messenger",
  "displayName": "Agent Messenger",
  "description": "Read and send agent-messenger messages from VS Code, through the bus monitor's HTTP API",
  "version": "0.1.0",
  "publisher": "gentoomaniac",
  "license": "GPL-2.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/gentoomaniac/agent-messenger.git",
    "directory": "vscode"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["Other"],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "configuration": {
      "title": "Agent Messenger",
      "properties": {
        "agentMessenger.url": {
          "type": "string",
          "default": "http://localhost:8080",
          "description": "Base URL of the bus monitor, for example http://localhost:8080 or its public URL behind a proxy."
        }
      }
    },
    "commands": [
      { "command": "agentMessenger.login", "title": "Log In", "category": "Agent Messenger" },
      { "command": "agentMessenger.logout", "title": "Log Out", "category": "Agent Messenger" },
      { "command": "agentMessenger.openChannel", "title": "Open Channel", "category": "Agent Messenger" }
    ],
    "menus": {
      "commandPalette": [{ "command": "agentMessenger.openChannel", "when": "false" }]
    },
    "viewsContainers": {
      "activitybar": [{ "id": "agentMessenger", "title": "Agent Messenger", "icon": "media/icon.svg" }]
    },
    "views": {
      "agentMessenger": [{ "id": "agentMessenger.tree", "name": "Agent Messenger" }]
    },
    "viewsWelcome": [
      {
        "view": "agentMessenger.tree",
        "contents": "Log in to the bus monitor to see channels and agents.\n[Log In](command:agentMessenger.login)",
        "when": "agentMessenger.loginRequired"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test out/test/",
    "check": "npm run typecheck && npm test && npm run build",
    "package": "npm run build && cp ../LICENSE LICENSE && vsce package --out agent-messenger.vsix"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "4.1.1",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
