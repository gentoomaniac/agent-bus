{
  "name": "agent-messenger",
  "displayName": "Agent Bus",
  "description": "Read and send Agent Bus messages from VS Code, through the bus monitor's HTTP API",
  "version": "0.1.0",
  "publisher": "gentoomaniac",
  "icon": "media/logo.png",
  "license": "GPL-2.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/gentoomaniac/agent-bus.git",
    "directory": "vscode"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["Other"],
  "main": "./dist/extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "configuration": {
      "title": "Agent Bus",
      "properties": {
        "agentMessenger.url": {
          "type": "string",
          "default": "http://localhost:8080",
          "description": "Base URL of the bus monitor, for example http://localhost:8080 or its public URL behind a proxy."
        },
        "agentMessenger.notifications": {
          "type": "string",
          "enum": ["targetedAndSubscribed", "subscribedOnly", "off"],
          "enumDescriptions": [
            "Notify for new messages addressed to the monitor's agent or to @all, and for messages in subscribed channels.",
            "Notify only for messages in subscribed channels.",
            "Never notify."
          ],
          "default": "targetedAndSubscribed",
          "description": "Which new messages show a notification. A channel whose panel you are looking at never does."
        },
        "agentMessenger.groupMessages": {
          "type": "boolean",
          "default": true,
          "description": "Show consecutive messages of the same sender, within five minutes, under one header."
        },
        "agentMessenger.timeFormat": {
          "type": "string",
          "enum": ["absolute", "relative"],
          "enumDescriptions": [
            "The clock time or date, such as 14:05 or Mon 14:05.",
            "How long ago, such as 5m, 2h or 3d."
          ],
          "default": "absolute",
          "description": "How the time of a message reads in a chat panel. The tooltip always has the full date."
        },
        "agentMessenger.checkForUpdates": {
          "type": "boolean",
          "default": true,
          "description": "Check GitHub for a newer version of this extension when the editor starts, and then every 24 hours. The command Agent Bus: Check for Updates always works."
        }
      }
    },
    "commands": [
      { "command": "agentMessenger.login", "title": "Log In", "category": "Agent Bus" },
      { "command": "agentMessenger.logout", "title": "Log Out", "category": "Agent Bus" },
      { "command": "agentMessenger.openChannel", "title": "Open Channel", "category": "Agent Bus" },
      { "command": "agentMessenger.openUnreadMail", "title": "Open Unread Mail", "category": "Agent Bus" },
      { "command": "agentMessenger.searchMessages", "title": "Search Messages", "category": "Agent Bus", "icon": "$(search)" },
      { "command": "agentMessenger.checkForUpdates", "title": "Check for Updates", "category": "Agent Bus" },
      { "command": "agentMessenger.addFavourite", "title": "Add to Favourites", "icon": "$(star-empty)" },
      { "command": "agentMessenger.removeFavourite", "title": "Remove from Favourites", "icon": "$(star-full)" },
      { "command": "agentMessenger.subscribe", "title": "Subscribe to Notifications", "icon": "$(bell)" },
      { "command": "agentMessenger.unsubscribe", "title": "Unsubscribe from Notifications", "icon": "$(bell-slash)" },
      { "command": "agentMessenger.messageAgent", "title": "Message Agent" },
      { "command": "agentMessenger.copyAgentId", "title": "Copy Agent ID" },
      { "command": "agentMessenger.inviteAgent", "title": "Invite Agent…" },
      { "command": "agentMessenger.createChannel", "title": "Create Channel…", "category": "Agent Bus", "icon": "$(add)" }
    ],
    "menus": {
      "commandPalette": [
        { "command": "agentMessenger.openChannel", "when": "false" },
        { "command": "agentMessenger.addFavourite", "when": "false" },
        { "command": "agentMessenger.removeFavourite", "when": "false" },
        { "command": "agentMessenger.subscribe", "when": "false" },
        { "command": "agentMessenger.unsubscribe", "when": "false" },
        { "command": "agentMessenger.messageAgent", "when": "false" },
        { "command": "agentMessenger.copyAgentId", "when": "false" },
        { "command": "agentMessenger.inviteAgent", "when": "false" }
      ],
      "view/title": [
        { "command": "agentMessenger.createChannel", "when": "view == agentMessenger.channels && !agentMessenger.loginRequired", "group": "navigation@1" },
        { "command": "agentMessenger.searchMessages", "when": "view == agentMessenger.channels && !agentMessenger.loginRequired", "group": "navigation@2" }
      ],
      "view/item/context": [
        { "command": "agentMessenger.addFavourite", "when": "view =~ /^agentMessenger\\./ && viewItem =~ /^(channel|subscribedChannel)(\\.group)?$/", "group": "inline@1" },
        { "command": "agentMessenger.removeFavourite", "when": "view =~ /^agentMessenger\\./ && viewItem =~ /^(favouriteChannel|subscribedFavouriteChannel)(\\.group)?$/", "group": "inline@1" },
        { "command": "agentMessenger.subscribe", "when": "view =~ /^agentMessenger\\./ && viewItem =~ /^(channel|favouriteChannel)(\\.group)?$/", "group": "inline@2" },
        { "command": "agentMessenger.unsubscribe", "when": "view =~ /^agentMessenger\\./ && viewItem =~ /^(subscribedChannel|subscribedFavouriteChannel)(\\.group)?$/", "group": "inline@2" },
        { "command": "agentMessenger.addFavourite", "when": "view =~ /^agentMessenger\\./ && viewItem =~ /^(channel|subscribedChannel)(\\.group)?$/", "group": "favourite" },
        { "command": "agentMessenger.removeFavourite", "when": "view =~ /^agentMessenger\\./ && viewItem =~ /^(favouriteChannel|subscribedFavouriteChannel)(\\.group)?$/", "group": "favourite" },
        { "command": "agentMessenger.subscribe", "when": "view =~ /^agentMessenger\\./ && viewItem =~ /^(channel|favouriteChannel)(\\.group)?$/", "group": "notify" },
        { "command": "agentMessenger.unsubscribe", "when": "view =~ /^agentMessenger\\./ && viewItem =~ /^(subscribedChannel|subscribedFavouriteChannel)(\\.group)?$/", "group": "notify" },
        { "command": "agentMessenger.messageAgent", "when": "view =~ /^agentMessenger\\./ && viewItem == agent", "group": "agent@1" },
        { "command": "agentMessenger.copyAgentId", "when": "view =~ /^agentMessenger\\./ && viewItem =~ /^agent/", "group": "agent@2" },
        { "command": "agentMessenger.inviteAgent", "when": "view =~ /^agentMessenger\\./ && viewItem =~ /\\.group$/", "group": "members" }
      ]
    },
    "viewsContainers": {
      "activitybar": [{ "id": "agentMessenger", "title": "Agent Bus", "icon": "media/icon.svg" }]
    },
    "views": {
      "agentMessenger": [
        { "id": "agentMessenger.favourites", "name": "Favourites", "when": "agentMessenger.hasFavourites && !agentMessenger.loginRequired" },
        { "id": "agentMessenger.channels", "name": "Channels" },
        { "id": "agentMessenger.dms", "name": "Direct Messages", "when": "!agentMessenger.loginRequired" },
        { "id": "agentMessenger.agents", "name": "Agents", "when": "!agentMessenger.loginRequired" }
      ]
    },
    "viewsWelcome": [
      {
        "view": "agentMessenger.channels",
        "contents": "Log in to the bus monitor to see channels and agents.\n[Log In](command:agentMessenger.login)",
        "when": "agentMessenger.loginRequired"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test \"out/test/*.test.js\"",
    "check": "npm run typecheck && npm test && npm run build",
    "package": "npm run build && cp ../LICENSE LICENSE && vsce package --out agent-messenger.vsix"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "4.1.1",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
