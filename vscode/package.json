{
  "name": "agent-messenger",
  "displayName": "Agent Messenger",
  "description": "Read and send agent-messenger messages from VS Code, through the bus monitor's HTTP API",
  "version": "0.1.0",
  "publisher": "gentoomaniac",
  "license": "GPL-2.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/gentoomaniac/agent-bus.git",
    "directory": "vscode"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["Other"],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "configuration": {
      "title": "Agent Messenger",
      "properties": {
        "agentMessenger.url": {
          "type": "string",
          "default": "http://localhost:8080",
          "description": "Base URL of the bus monitor, for example http://localhost:8080 or its public URL behind a proxy."
        }
      }
    },
    "commands": [
      { "command": "agentMessenger.login", "title": "Log In", "category": "Agent Messenger" },
      { "command": "agentMessenger.logout", "title": "Log Out", "category": "Agent Messenger" },
      { "command": "agentMessenger.openChannel", "title": "Open Channel", "category": "Agent Messenger" },
      { "command": "agentMessenger.openUnreadMail", "title": "Open Unread Mail", "category": "Agent Messenger" },
      { "command": "agentMessenger.addFavourite", "title": "Add to Favourites", "icon": "$(star-empty)" },
      { "command": "agentMessenger.removeFavourite", "title": "Remove from Favourites", "icon": "$(star-full)" },
      { "command": "agentMessenger.messageAgent", "title": "Message Agent" },
      { "command": "agentMessenger.copyAgentId", "title": "Copy Agent ID" }
    ],
    "menus": {
      "commandPalette": [
        { "command": "agentMessenger.openChannel", "when": "false" },
        { "command": "agentMessenger.addFavourite", "when": "false" },
        { "command": "agentMessenger.removeFavourite", "when": "false" },
        { "command": "agentMessenger.messageAgent", "when": "false" },
        { "command": "agentMessenger.copyAgentId", "when": "false" }
      ],
      "view/item/context": [
        { "command": "agentMessenger.addFavourite", "when": "view == agentMessenger.tree && viewItem == channel", "group": "inline" },
        { "command": "agentMessenger.removeFavourite", "when": "view == agentMessenger.tree && viewItem == favouriteChannel", "group": "inline" },
        { "command": "agentMessenger.addFavourite", "when": "view == agentMessenger.tree && viewItem == channel", "group": "favourite" },
        { "command": "agentMessenger.removeFavourite", "when": "view == agentMessenger.tree && viewItem == favouriteChannel", "group": "favourite" },
        { "command": "agentMessenger.messageAgent", "when": "view == agentMessenger.tree && viewItem == agent", "group": "agent@1" },
        { "command": "agentMessenger.copyAgentId", "when": "view == agentMessenger.tree && viewItem =~ /^agent/", "group": "agent@2" }
      ]
    },
    "viewsContainers": {
      "activitybar": [{ "id": "agentMessenger", "title": "Agent Messenger", "icon": "media/icon.svg" }]
    },
    "views": {
      "agentMessenger": [{ "id": "agentMessenger.tree", "name": "Agent Messenger" }]
    },
    "viewsWelcome": [
      {
        "view": "agentMessenger.tree",
        "contents": "Log in to the bus monitor to see channels and agents.\n[Log In](command:agentMessenger.login)",
        "when": "agentMessenger.loginRequired"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test \"out/test/*.test.js\"",
    "check": "npm run typecheck && npm test && npm run build",
    "package": "npm run build && cp ../LICENSE LICENSE && vsce package --out agent-messenger.vsix"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "4.1.1",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
